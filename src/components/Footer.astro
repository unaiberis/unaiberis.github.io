---
const { footerTitle, footerText } = Astro.props;
---

<footer id="contact" class="bg-blue-900 text-white py-12">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <h2 class="text-3xl font-bold mb-6">{footerTitle}</h2>
    <p class="text-lg mb-4">{footerText}</p>
    <div class="flex justify-center space-x-4">
      <a href="https://github.com/unaiberis" class="text-white hover:text-gray-300">GitHub</a>
      <a href="https://www.linkedin.com/in/unaiberis/" class="text-white hover:text-gray-300">LinkedIn</a>
    </div>
  </div>
</footer>