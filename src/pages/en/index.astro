---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const navLinks = [
  { href: "#about", text: "About" },
  { href: "#experience", text: "Experience" },
  { href: "#projects", text: "Projects" },
  { href: "#skills", text: "Skills" },
  { href: "#education", text: "Education" },
  { href: "#contact", text: "Contact" },
];
const footerTitle = "Get in Touch";
const footerText = "Interested in collaborating? Let’s connect!";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Unai Beristain - Portfolio</title>
  </head>
  <body class="bg-gray-50 font-sans">
    <Header lang="en" navLinks={navLinks} />
    <!-- About Section -->
    <section id="about" class="bg-gradient-to-r from-blue-50 to-blue-100 py-20">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-5xl font-bold text-gray-900 text-center mb-10">About Me</h2>
        <div class="bg-white p-8 rounded-xl shadow-xl flex flex-col md:flex-row items-start gap-8">
          <div class="md:w-1/2">
            <p class="text-xl text-gray-700 leading-relaxed">
              Hi, I'm <span class="font-bold hover:underline">Unai Beristain Aramendi</span>, a <span class="font-bold text-blue-600 hover:underline">Full-Stack Odoo Developer</span> who has <span class="font-bold text-blue-600 hover:underline">passed the CFA Level I exam and is now a candidate for CFA Level II</span> with a <span class="font-bold hover:underline">Telecommunications Engineering degree</span>. I excel in <span class="font-bold text-blue-600 hover:underline">Python, HTML, CSS, JavaScript, SQL, cybersecurity</span>, and <span class="font-bold text-blue-600 hover:underline">financial analysis</span>, backed by 5 years of value investing.
            </p>
          </div>
          <div class="md:w-1/2">
            <div class="bg-blue-100 p-6 rounded-lg shadow-md">
              <div class="space-y-4">
                <a href="https://www.linkedin.com/in/unaiberis/" class="inline-flex items-center bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 hover:scale-105 transition w-full justify-center">
                  <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.327-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  Connect on LinkedIn
                </a>
                <a href="https://github.com/unaiberis" class="inline-flex items-center bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 hover:scale-105 transition w-full justify-center">
                  <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.12-1.47-1.12-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.5 2.28 1.07 2.84.81.09-.63.35-1.07.63-1.32-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85 0 1.71.11 2.51.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.16.59.67.5A10 10 0 0 0 22 12 10 10 0 0 0 12 2z"/>
                  </svg>
                  Code on GitHub
                </a>
              </div>
              <div class="mt-6">
                <h3 class="text-lg font-semibold text-gray-800 mb-4 border-t-2 border-blue-600 pt-4">Languages</h3>
                <div class="space-y-4">
                  <div>
                    <p class="text-sm font-medium text-gray-700">Basque (Native, EGA Certificate)</p>
                    <div class="w-full bg-gray-200 rounded-full h-2.5 mt-1">
                      <div class="bg-blue-600 h-2.5 rounded-full" style="width: 100%"></div>
                    </div>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-gray-700">Spanish (Fluent)</p>
                    <div class="w-full bg-gray-200 rounded-full h-2.5 mt-1">
                      <div class="bg-blue-600 h-2.5 rounded-full" style="width: 100%"></div>
                    </div>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-gray-700">English (Fluent, CAE)</p>
                    <div class="w-full bg-gray-200 rounded-full h-2.5 mt-1">
                      <div class="bg-blue-600 h-2.5 rounded-full" style="width: 100%"></div>
                    </div>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-gray-700">German (Intermediate)</p>
                    <div class="w-full bg-gray-200 rounded-full h-2.5 mt-1">
                      <div class="bg-blue-600 h-2.5 rounded-full" style="width: 50%"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- Experience Section -->
    <section id="experience" class="bg-gray-100 py-16">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold text-gray-900 text-center mb-10">Experience</h2>
        <div class="space-y-8">
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold text-gray-900">Full-Stack Odoo Developer</h3>
            <p class="text-gray-600">AvanzOSC | 2023 – 2025</p>
            <ul class="list-disc list-inside text-gray-700 mt-2">
              <li>Led Odoo ERP implementation projects for clients.</li>
              <li>Developed custom Odoo modules using Python and frontend technologies.</li>
              <li>Improved module development with AI and automation.</li>
              <li>Implemented a reporting module enhancing client insights.</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold text-gray-900">Intern, Vibration Monitoring</h3>
            <p class="text-gray-600">Tecnalia R&D | 2023 – 2024</p>
            <ul class="list-disc list-inside text-gray-700 mt-2">
              <li>Developed a vibration monitoring prototype for thesis.</li>
              <li>Presented research at a conference.</li>
              <li>Optimized data collection for improved accuracy.</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold text-gray-900">Musician</h3>
            <p class="text-gray-600">Txalkor Txistulari Taldea | 2008 – Present</p>
            <ul class="list-disc list-inside text-gray-700 mt-2">
              <li>Play txistu, danbolin, txirula, and pandero in Basque cultural events.</li>
              <li>
                Perform with <a href="https://sahatsa.com/" class="text-blue-600 hover:underline">Sahatsa Dantza Taldea</a> (<a href="https://www.youtube.com/@sahatsa" class="text-blue-600 hover:underline">YouTube</a>, <a href="https://www.instagram.com/sahatsadt/" class="text-blue-600 hover:underline">Instagram</a>).
              </li>
              <li>Contribute to preserving Basque musical heritage.</li>
              <li>
                Follow Txalkor on <a href="https://www.instagram.com/txalkortxistu/" class="text-blue-600 hover:underline">Instagram</a>.
              </li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold text-gray-900">Euskalkis Video Prize Winner</h3>
            <p class="text-gray-600">Floreaga Salestar Ikastetxea | 2017</p>
            <ul class="list-disc list-inside text-gray-700 mt-2">
              <li>Won Eusko Jaurlaritza prize for a video promoting Euskalkis dialects.</li>
              <li>
                Video featured in <a href="https://youtu.be/b-irRYVpZDo" class="text-blue-600 hover:underline">Berdinean Desberdin</a> project, recognized by Lehendakari Urkullu.
              </li>
              <li>Contributed to cultural preservation through multimedia storytelling.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
    <!-- Projects Section -->
    <section id="projects" class="max-w-7xl mx-auto px-4 py-16">
      <h2 class="text-4xl font-bold text-gray-900 text-center mb-10">Projects</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Custom Odoo Reporting Module</h3>
          <p class="text-gray-600 mb-4">
            Developed a tailored Odoo module to enhance client reporting, integrating AI for data
            insights.
          </p>
          <a href="https://github.com/unaiberis" class="text-blue-600 hover:underline">View on GitHub</a>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Euskalkis Video Project</h3>
          <p class="text-gray-600 mb-4">
            Created a prize-winning video for Eusko Jaurlaritza, promoting Basque dialects.
          </p>
          <a href="https://youtu.be/b-irRYVpZDo" class="text-blue-600 hover:underline">Watch Video</a>
        </div>
      </div>
    </section>
    <!-- Skills Section -->
    <section id="skills" class="bg-gray-100 py-16">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold text-gray-900 text-center mb-10">Skills</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Python</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">JavaScript</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">HTML</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">CSS</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">SQL</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Odoo</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Cybersecurity</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Finance</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Linux</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Bash</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Excel</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Git</div>
        </div>
      </div>
    </section>
    <!-- Education Section -->
    <section id="education" class="max-w-7xl mx-auto px-4 py-16">
      <h2 class="text-4xl font-bold text-gray-900 text-center mb-10">Education</h2>
      <div class="space-y-8">
        <div class="bg-white p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-semibold text-gray-900">Telecommunication Engineering</h3>
          <p class="text-gray-600">Euskal Herriko Unibertsitatea | 2019 – 2024</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-semibold text-gray-900">High School</h3>
          <p class="text-gray-600">Azkoitia BHI | 2017 – 2019</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-semibold text-gray-900">Primary & Secondary Education</h3>
          <p class="text-gray-600">Floreaga Salestar Ikastetxea | 2003 – 2017</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-semibold text-gray-900">Traditional Basque Music</h3>
          <p class="text-gray-600">Txalkor Txistulari Taldea | 2008 – Present</p>
          <p class="text-gray-700 mt-2">
            Trained in playing txistu, danbolin, txirula, and pandero, contributing to Basque cultural events.
          </p>
        </div>
      </div>
    </section>
    <Footer footerTitle={footerTitle} footerText={footerText} />
  </body>
</html>