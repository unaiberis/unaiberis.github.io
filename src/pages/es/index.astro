---
import '../../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Unai Beristain - Portafolio</title>
  </head>
  <body class="bg-gray-50 font-sans">
    <!-- Header -->
    <header class="bg-blue-700 text-white sticky top-0 shadow-lg">
      <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
        <h1 class="text-2xl font-bold">Unai Beristain</h1>
        <nav class="flex items-center space-x-4">
          <a href="#about" class="px-3 py-2 hover:bg-blue-800 rounded">Sobre Mí</a>
          <a href="#experience" class="px-3 py-2 hover:bg-blue-800 rounded">Experiencia</a>
          <a href="#projects" class="px-3 py-2 hover:bg-blue-800 rounded">Proyectos</a>
          <a href="#skills" class="px-3 py-2 hover:bg-blue-800 rounded">Habilidades</a>
          <a href="#education" class="px-3 py-2 hover:bg-blue-800 rounded">Educación</a>
          <a href="#contact" class="px-3 py-2 hover:bg-blue-800 rounded">Contacto</a>
          <div class="flex items-center space-x-2">
            <a href="/" aria-label="Switch to Basque" class="inline-flex rounded-full p-1 hover:bg-blue-800">
              <img src="/flags/bandera-eu.svg" alt="Basque flag" class="w-8 h-8" />
            </a>
            <a href="/es" aria-label="Switch to Spanish" class="inline-flex rounded-full p-1 hover:bg-blue-800 ring-2 ring-blue-300">
              <img src="/flags/bandera-es.svg" alt="Spanish flag" class="w-8 h-8" />
            </a>
            <a href="/en" aria-label="Switch to English" class="inline-flex rounded-full p-1 hover:bg-blue-800">
              <img src="/flags/bandera-en.svg" alt="English flag" class="w-8 h-8" />
            </a>
          </div>
        </nav>
      </div>
    </header>

    <!-- About Section -->
    <section id="about" class="bg-gradient-to-r from-blue-50 to-blue-100 py-20">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-5xl font-bold text-gray-900 text-center mb-10">Sobre Mí</h2>
        <div class="bg-white p-8 rounded-xl shadow-xl flex flex-col md:flex-row items-start gap-8">
          <div class="md:w-1/2">
            <p class="text-xl text-gray-700 leading-relaxed">
              Hola, soy <span class="font-bold hover:underline">Unai Beristain Aramendi</span>, <span class="font-bold text-blue-600 hover:underline">Desarrollador Full-Stack de Odoo</span> que ha <span class="font-bold text-blue-600 hover:underline">aprobado el examen CFA Nivel I y ahora es candidato para el CFA Nivel II</span> con un título en <span class="font-bold hover:underline">Ingeniería de Telecomunicaciones</span>. Destaco en <span class="font-bold text-blue-600 hover:underline">Python, HTML, CSS, JavaScript, SQL, ciberseguridad</span> y <span class="font-bold text-blue-600 hover:underline">análisis financiero</span>, respaldado por 5 años de inversión en valor.
            </p>
          </div>
          <div class="md:w-1/2">
            <div class="bg-blue-100 p-6 rounded-lg shadow-md">
              <div class="space-y-4">
                <a href="https://www.linkedin.com/in/unaiberis/" class="inline-flex items-center bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 hover:scale-105 transition w-full justify-center">
                  <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.327-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  Conectar en LinkedIn
                </a>
                <a href="https://github.com/unaiberis" class="inline-flex items-center bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 hover:scale-105 transition w-full justify-center">
                  <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.12-1.47-1.12-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.5 2.28 1.07 2.84.81.09-.63.35-1.07.63-1.32-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85 0 1.71.11 2.51.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.16.59.67.5A10 10 0 0 0 22 12 10 10 0 0 0 12 2z"/>
                  </svg>
                  Código en GitHub
                </a>
              </div>
              <div class="mt-6">
                <h3 class="text-lg font-semibold text-gray-800 mb-4 border-t-2 border-blue-600 pt-4">Idiomas</h3>
                <div class="space-y-4">
                  <div>
                    <p class="text-sm font-medium text-gray-700">Euskera (Nativo, Certificado EGA)</p>
                    <div class="w-full bg-gray-200 rounded-full h-2.5 mt-1">
                      <div class="bg-blue-600 h-2.5 rounded-full" style="width: 100%"></div>
                    </div>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-gray-700">Español (Fluido)</p>
                    <div class="w-full bg-gray-200 rounded-full h-2.5 mt-1">
                      <div class="bg-blue-600 h-2.5 rounded-full" style="width: 100%"></div>
                    </div>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-gray-700">Inglés (Fluido, CAE)</p>
                    <div class="w-full bg-gray-200 rounded-full h-2.5 mt-1">
                      <div class="bg-blue-600 h-2.5 rounded-full" style="width: 100%"></div>
                    </div>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-gray-700">Alemán (Intermedio)</p>
                    <div class="w-full bg-gray-200 rounded-full h-2.5 mt-1">
                      <div class="bg-blue-600 h-2.5 rounded-full" style="width: 50%"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section id="experience" class="bg-gray-100 py-16">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold text-gray-900 text-center mb-10">Experiencia</h2>
        <div class="space-y-8">
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold text-gray-900">Desarrollador Full-Stack de Odoo</h3>
            <p class="text-gray-600">AvanzOSC | 2023 – 2025</p>
            <ul class="list-disc list-inside text-gray-700 mt-2">
              <li>Lideré proyectos de implementación de Odoo ERP para clientes.</li>
              <li>Desarrollé módulos personalizados de Odoo usando Python y tecnologías frontend.</li>
              <li>Mejoré el desarrollo de módulos con IA y automatización.</li>
              <li>Implementé un módulo de informes que mejora los conocimientos de los clientes.</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold text-gray-900">Prácticas, Monitoreo de Vibraciones</h3>
            <p class="text-gray-600">Tecnalia R&D | 2023 – 2024</p>
            <ul class="list-disc list-inside text-gray-700 mt-2">
              <li>Desarrollé un prototipo de monitoreo de vibraciones para mi tesis.</li>
              <li>Presenté una investigación en una conferencia.</li>
              <li>Optimicé la recolección de datos para mejorar la precisión.</li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold text-gray-900">Músico</h3>
            <p class="text-gray-600">Txalkor Txistulari Taldea | 2008 – Presente</p>
            <ul class="list-disc list-inside text-gray-700 mt-2">
              <li>Toco txistu, danbolin, txirula y pandero en eventos culturales vascos.</li>
              <li>
                Actúo con <a href="https://sahatsa.com/" class="text-blue-600 hover:underline">Sahatsa Dantza Taldea</a> (<a href="https://www.youtube.com/@sahatsa" class="text-blue-600 hover:underline">YouTube</a>, <a href="https://www.instagram.com/sahatsadt/" class="text-blue-600 hover:underline">Instagram</a>).
              </li>
              <li>Contribuyo a preservar el patrimonio musical vasco.</li>
              <li>
                Sigue a Txalkor en <a href="https://www.instagram.com/txalkortxistu/" class="text-blue-600 hover:underline">Instagram</a>.
              </li>
            </ul>
          </div>
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold text-gray-900">Ganador del Premio de Video Euskalkis</h3>
            <p class="text-gray-600">Floreaga Salestar Ikastetxea | 2017</p>
            <ul class="list-disc list-inside text-gray-700 mt-2">
              <li>Gané el premio de Eusko Jaurlaritza por un video que promueve los dialectos Euskalkis.</li>
              <li>
                El video se destacó en el proyecto <a href="https://youtu.be/b-irRYVpZDo" class="text-blue-600 hover:underline">Berdinean Desberdin</a>, reconocido por el Lehendakari Urkullu.
              </li>
              <li>Contribuí a la preservación cultural a través de la narrativa multimedia.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="max-w-7xl mx-auto px-4 py-16">
      <h2 class="text-4xl font-bold text-gray-900 text-center mb-10">Proyectos</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Módulo de Informes Personalizado de Odoo</h3>
          <p class="text-gray-600 mb-4">
            Desarrollé un módulo personalizado de Odoo para mejorar los informes de clientes, integrando IA para análisis de datos.
          </p>
          <a href="https://github.com/unaiberis" class="text-blue-600 hover:underline">Ver en GitHub</a>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md hover:shadow-xl transition">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Proyecto de Video Euskalkis</h3>
          <p class="text-gray-600 mb-4">
            Creé un video galardonado para Eusko Jaurlaritza, promoviendo los dialectos vascos.
          </p>
          <a href="https://youtu.be/b-irRYVpZDo" class="text-blue-600 hover:underline">Ver Video</a>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="bg-gray-100 py-16">
      <div class="max-w-7xl mx-auto px-4">
        <h2 class="text-4xl font-bold text-gray-900 text-center mb-10">Habilidades</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Python</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">JavaScript</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">HTML</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">CSS</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">SQL</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Odoo</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Ciberseguridad</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Finanzas</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Linux</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Bash</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Excel</div>
          <div class="bg-blue-600 text-white p-4 rounded-lg text-center">Git</div>
        </div>
      </div>
    </section>

    <!-- Education Section -->
    <section id="education" class="max-w-7xl mx-auto px-4 py-16">
      <h2 class="text-4xl font-bold text-gray-900 text-center mb-10">Educación</h2>
      <div class="space-y-8">
        <div class="bg-white p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-semibold text-gray-900">Ingeniería de Telecomunicaciones</h3>
          <p class="text-gray-600">Euskal Herriko Unibertsitatea | 2019 – 2024</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-semibold text-gray-900">Bachillerato</h3>
          <p class="text-gray-600">Azkoitia BHI | 2017 – 2019</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-semibold text-gray-900">Educación Primaria y Secundaria</h3>
          <p class="text-gray-600">Floreaga Salestar Ikastetxea | 2003 – 2017</p>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md">
          <h3 class="text-xl font-semibold text-gray-900">Música Tradicional Vasca</h3>
          <p class="text-gray-600">Txalkor Txistulari Taldea | 2008 – Presente</p>
          <p class="text-gray-700 mt-2">
            Entrenado en tocar txistu, danbolin, txirula y pandero, contribuyendo a eventos culturales vascos.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Footer -->
    <footer id="contact" class="bg-blue-900 text-white py-12">
      <div class="max-w-7xl mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-6">Contacto</h2>
        <p class="text-lg mb-4">¿Interesado en colaborar? ¡Conectemos!</p>
        <div class="flex justify-center space-x-4">
          <a href="https://github.com/unaiberis" class="text-white hover:text-gray-300">GitHub</a>
          <a href="https://www.linkedin.com/in/unaiberis/" class="text-white hover:text-gray-300">LinkedIn</a>
        </div>
      </div>
    </footer>
  </body>
</html>